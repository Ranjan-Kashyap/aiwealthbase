{
  "name": "ai-wealth-base-website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "generate-blog": "node scripts/generate-blog.mjs",
    "predev": "node scripts/generate-blog.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/generate-blog.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "build:cf": "node scripts/generate-blog.mjs && opennextjs-cloudflare build",
    "deploy": "node scripts/generate-blog.mjs && opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv ./cloudflare-env.d.ts"
  },
  "dependencies": {
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.19.8",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "gray-matter": "^4.0.3",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-pretty-code": "^0.14.3",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "shiki": "^4.0.2",
    "tailwindcss": "^4",
    "typescript": "^5",
    "unified": "^11.0.5",
    "wrangler": "^4.90.0"
  }
}
